<?xml version="1.0"?>
<robot name="orange_robot" xmlns:xacro="http://ros.org/wiki/xacro">
  
  <!-- 색상 물감 준비 -->
  <material name="yellow"><color rgba="0.9 0.8 0.0 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="silver"><color rgba="0.8 0.8 0.8 1.0"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>

  <!-- 1. 노란색 본체 -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.8 0.5 0.3"/></geometry>
      <material name="yellow"/>
    </visual>
  </link>

  <!-- 2. 회색 지붕 -->
  <joint name="cover_joint" type="fixed">
    <parent link="base_link"/><child link="top_cover"/>
    <origin xyz="0 0 0.16" rpy="0 0 0"/>
  </joint>
  <link name="top_cover">
    <visual><geometry><box size="0.8 0.5 0.02"/></geometry><material name="grey"/></visual>
  </link>

  <!-- 3. 은색 기둥 두 개 (마스트) -->
  <joint name="front_mast_joint" type="fixed">
    <parent link="base_link"/><child link="front_mast_link"/>
    <origin xyz="0.3 0 0.41" rpy="0 0 0"/>
  </joint>
  <link name="front_mast_link">
    <visual><geometry><cylinder radius="0.02" length="0.5"/></geometry><material name="silver"/></visual>
  </link>

  <joint name="rear_mast_joint" type="fixed">
    <parent link="base_link"/><child link="rear_mast_link"/>
    <origin xyz="-0.3 0 0.56" rpy="0 0 0"/>
  </joint>
  <link name="rear_mast_link">
    <visual><geometry><cylinder radius="0.02" length="0.8"/></geometry><material name="silver"/></visual>
  </link>

  <!-- 4. 빨간색 카메라 & 노란색 센서 -->
  <joint name="front_camera_joint" type="fixed">
    <parent link="front_mast_link"/><child link="front_camera"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
  </joint>
  <link name="front_camera">
    <visual><geometry><box size="0.05 0.05 0.05"/></geometry><material name="red"/></visual>
  </link>

  <joint name="rear_sensor_joint" type="fixed">
    <parent link="rear_mast_link"/><child link="rear_sensor"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
  </joint>
  <link name="rear_sensor">
    <visual><geometry><box size="0.1 0.1 0.1"/></geometry><material name="yellow"/></visual>
  </link>

  <!-- 5. 크고 듬직한 메인 구동 바퀴 -->
  <joint name="left_wheel_hinge" type="continuous">
    <parent link="base_link"/><child link="left_wheel"/>
    <origin xyz="0 0.28 -0.15" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="left_wheel">
    <visual><geometry><cylinder radius="0.1" length="0.05"/></geometry><material name="grey"/></visual>
  </link>

  <joint name="right_wheel_hinge" type="continuous">
    <parent link="base_link"/><child link="right_wheel"/>
    <origin xyz="0 -0.28 -0.15" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="right_wheel">
    <visual><geometry><cylinder radius="0.1" length="0.05"/></geometry><material name="grey"/></visual>
  </link>

  <!-- 6. 까만색 보조 바퀴 (캐스터 4개) -->
  <joint name="fl_caster_joint" type="fixed"><parent link="base_link"/><child link="fl_caster"/><origin xyz="0.35 0.2 -0.2" rpy="0 0 0"/></joint>
  <link name="fl_caster"><visual><geometry><sphere radius="0.05"/></geometry><material name="black"/></visual></link>
  <joint name="fr_caster_joint" type="fixed"><parent link="base_link"/><child link="fr_caster"/><origin xyz="0.35 -0.2 -0.2" rpy="0 0 0"/></joint>
  <link name="fr_caster"><visual><geometry><sphere radius="0.05"/></geometry><material name="black"/></visual></link>
  <joint name="rl_caster_joint" type="fixed"><parent link="base_link"/><child link="rl_caster"/><origin xyz="-0.35 0.2 -0.2" rpy="0 0 0"/></joint>
  <link name="rl_caster"><visual><geometry><sphere radius="0.05"/></geometry><material name="black"/></visual></link>
  <joint name="rr_caster_joint" type="fixed"><parent link="base_link"/><child link="rr_caster"/><origin xyz="-0.35 -0.2 -0.2" rpy="0 0 0"/></joint>
  <link name="rr_caster"><visual><geometry><sphere radius="0.05"/></geometry><material name="black"/></visual></link>

</robot>