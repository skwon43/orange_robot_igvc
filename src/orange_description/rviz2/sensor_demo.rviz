Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Hokuyo LaserScan1
        - /ZED Forward Depth Point Cloud1
        - /Front RealSense RGB1
        - /ZED RGB1
      Splitter Ratio: 0.550000011920929
    Tree Height: 122
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
